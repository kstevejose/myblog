---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }).format(d);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover ?? '/img/personal.jpg'}
  article
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article>
    <!-- header -->
    <header class="ph">
      <div class="wrap">
        <a class="back label label--plain" href="/posts">&#8592; &nbsp;All writing</a>

        <h1 class="ph-t">{post.data.title}</h1>
        {post.data.description && <p class="lead ph-d">{post.data.description}</p>}

        <div class="ph-meta">
          <span class="glyph" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <span class="sep" aria-hidden="true">/</span>
          <span>{post.data.readingTime} min read</span>
          <span class="sep" aria-hidden="true">/</span>
          <span class="ph-tags">
            {post.data.tags.map((t) => <span class="pill">{t}</span>)}
          </span>
        </div>
      </div>
    </header>

    {
      post.data.cover && (
        <div class="wrap">
          <img class="cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} />
        </div>
      )
    }

    <!-- body -->
    <div class="wrap">
      <div class="body">
        {
          toc.length > 2 && (
            <aside class="toc">
              <p class="label label--plain toc-h">On this page</p>
              <nav>
                <ul>
                  {toc.map((h) => (
                    <li class:list={['toc-i', { 'toc-i--sub': h.depth === 3 }]}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )
        }

        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    <!-- footer nav -->
    <nav class="pn" aria-label="More posts">
      <div class="wrap pn-grid">
        {
          prev ? (
            <a class="pn-a" href={`/posts/${prev.id}/`}>
              <span class="label label--plain">&#8592; Previous</span>
              <span class="pn-t">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="pn-a pn-a--r" href={`/posts/${next.id}/`}>
              <span class="label label--plain">Next &#8594;</span>
              <span class="pn-t">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </div>
    </nav>
  </article>
</Base>

<style>
  .progress {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 49;
    background: transparent;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  .ph { padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem; }
  .back {
    display: inline-flex;
    color: var(--fg-dim);
    margin-bottom: 2.5rem;
    transition: color 0.3s var(--ease);
  }
  .back:hover { color: var(--fg); }

  .ph-t {
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-bottom: 1.25rem;
  }
  .ph-d { margin-bottom: 2rem; }

  .ph-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .ph-meta .glyph i { height: 8px; }
  .ph-meta .glyph i:nth-child(3) { height: 14px; }
  .sep { color: var(--fg-dim); }
  .ph-tags { display: inline-flex; gap: 0.4rem; flex-wrap: wrap; }

  .cover {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-block: 1rem 3rem;
  }

  .body {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .body:has(> .prose:only-child) { grid-template-columns: minmax(0, 1fr); }

  .toc { position: sticky; top: 110px; }
  .toc-h { margin-bottom: 1rem; }
  .toc-i { border-left: 1px solid var(--line); }
  .toc-i a {
    display: block;
    padding: 0.4rem 0 0.4rem 1rem;
    font-size: 0.82rem;
    color: var(--fg-dim);
    line-height: 1.4;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
    margin-left: -1px;
    border-left: 1px solid transparent;
  }
  .toc-i a:hover { color: var(--fg); border-left-color: var(--accent); }
  .toc-i--sub a { padding-left: 1.9rem; font-size: 0.78rem; }

  .pn { border-top: 1px solid var(--line); }
  .pn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    min-height: 160px;
  }
  .pn-a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: 2.5rem 2rem 2.5rem 0;
    transition: background 0.35s var(--ease), padding 0.35s var(--ease);
  }
  .pn-a--r { text-align: right; align-items: flex-end; padding: 2.5rem 0 2.5rem 2rem; border-left: 1px solid var(--line); }
  .pn-a:hover { background: rgba(255, 255, 255, 0.02); }
  .pn-t { font-size: clamp(1.05rem, 2vw, 1.4rem); font-weight: 500; letter-spacing: -0.02em; max-width: 22ch; }

  @media (max-width: 940px) {
    .body { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .toc { position: static; border-bottom: 1px solid var(--line); padding-bottom: 1.5rem; }
    .toc nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
    .toc-i { border-left: 0; }
    .toc-i a { padding: 0.2rem 0; }
    .toc-i--sub { display: none; }
    .pn-grid { grid-template-columns: 1fr; }
    .pn-a--r { text-align: left; align-items: flex-start; padding: 2rem 0; border-left: 0; border-top: 1px solid var(--line); }
  }
</style>

<script>
  const wireProgress = () => {
    const bar = document.querySelector('[data-progress]') as HTMLElement | null;
    if (!bar) return;

    let raf = 0;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      raf = 0;
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  };

  document.addEventListener('astro:page-load', wireProgress);
</script>
